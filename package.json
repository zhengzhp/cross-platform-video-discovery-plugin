{
  "name": "cross-platform-video-discovery-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Pi 与 DeepSeek Harness 视频发现插件共享核心（开发中）",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./core": "./dist/core/index.js",
